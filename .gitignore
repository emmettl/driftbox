# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.tsbuildinfo
*.local

# Compiled output that landed in a source tree rather than in dist/. Both library packages
# are TypeScript only, and both ship `src` in their `files`, so a stray .js or .d.ts here
# would be committed AND published. A misconfigured rootDir put 136 of them in
# packages/engine/src once; `dist` above does not catch that.
packages/engine/src/**/*.js
packages/engine/src/**/*.d.ts
packages/engine/src/**/*.map
packages/rack/src/**/*.js
packages/rack/src/**/*.d.ts
packages/rack/src/**/*.map

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.claude
*.tgz
