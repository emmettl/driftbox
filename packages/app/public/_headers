# Cloudflare static-asset rules. GitHub Pages uses its own cache policy.
/
  Cache-Control: public, max-age=0, must-revalidate
  X-Driftbox-Hosting: cloudflare-worker

/index.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Driftbox-Hosting: cloudflare-worker

/rack.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Driftbox-Hosting: cloudflare-worker

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate

/_release.json
  Cache-Control: no-cache
