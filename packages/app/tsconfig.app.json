{
  "compilerOptions": {
    "tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    // Resolve the workspace packages to their SOURCE for type-checking, matching the alias in
    // vite.config.ts and vitest.config.ts. Without it, `tsc -b` on a fresh checkout
    // fails until the engine has been built — which would make the app's type-check
    // depend on build order for no good reason.
    "paths": {
      "@driftbox/engine": ["../engine/src/index.ts"],
      "@driftbox/rack": ["../rack/src/index.ts"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
